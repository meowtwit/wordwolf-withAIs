# 使いたいプロバイダのキーだけ設定すればOK。何も設定しなくても「オフライン(mock)」AIで遊べます。
# 各サービスの利用規約（年齢条件など）を必ず確認してください。

PORT=3000

# Google Gemini API
GEMINI_API_KEY=
# 3.8 Flash（gemini-flash-latest）は返事に1分以上かかることがあるため、Flash-Lite を既定にしています
# GEMINI_MODEL=gemini-flash-lite-latest

# GroqCloud
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Hugging Face Inference Providers
HF_TOKEN=
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cerebras Inference
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama3.1-8b

# ローカルモデル（Ollama など OpenAI 互換サーバー）
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# 1分あたりに AI を呼んでよい回数（無料枠の上限に合わせる。0 で制限なし）
# 無料枠の上限は 15回/分。余裕を見て既定は 12
# GEMINI_RPM=12
